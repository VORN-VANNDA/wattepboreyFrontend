{
  "name": "wattepboreyfrontend",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/slides/*",
      "/events/*",
      "/members/*",
      "/donors/*",
      "/pchum-ben/*"
    ]
  },
  "main": "worker.js",
  "vars": {
    "API_ORIGIN": "https://tebpoery-backend.onrender.com/api"
  }
}
